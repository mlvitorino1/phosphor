# PostgreSQL para histórico, administração e ingestão agendada
DATABASE_URL=
# Opcional: conexão com permissão de DDL, usada apenas por npm run db:migrate
DATABASE_MIGRATION_URL=

# Senha de 12 a 256 caracteres; segredos de sessão com pelo menos 32 caracteres
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Segredo aleatório de pelo menos 32 caracteres enviado em Authorization para /api/ingest
CRON_SECRET=

# Opcional: ative observações de focos de calor da NASA FIRMS
FIRMS_MAP_KEY=

# Contas públicas (exigido em produção junto com DATABASE_URL)
USER_SESSION_SECRET=
PUBLIC_APP_URL=

# Análise assistida de trechos de notícias pelo modelo escolhido
OPENAI_API_KEY=
OPENAI_MODEL=

# E-mail de recuperação, confirmação e alertas; MAIL_FROM deve ser remetente autorizado
RESEND_API_KEY=
MAIL_FROM=

# Integrações opcionais para notícias aprovadas com risco relevante na cadeia de suprimentos
SLACK_WEBHOOK_URL=
ERP_WEBHOOK_URL=
ERP_WEBHOOK_TOKEN=
