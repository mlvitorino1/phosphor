# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/data/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
/.aws/
/.ssh/
/.npmrc
/service-account*.json
/gitleaks-report*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Real environment files are private; the template contains no values.
.env*
!.env.example
/public/maplibre/
/test-results/
/playwright-report/
/.auth/
*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
