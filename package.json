{
  "name": "phosphor",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "history:import": "node scripts/import-gdelt-history.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:files": "node scripts/check-publication.mjs",
    "security:scan": "gitleaks git . --redact --log-opts=--all --no-banner",
    "check": "npm run security:files && npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "country-list": "^2.4.1",
    "country-list-js": "^4.0.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "tldts": "^7.4.16",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/country-list": "^2.1.4",
    "@types/node": "26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "^7",
    "vitest": "5.0.3"
  },
  "description": "Global events and news monitoring with an interactive globe and transparent source review.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
